[Unit]
Description=EDID fallback for wedged HDMI monitors
# Ubuntu runs GDM (not weston). Must inject the EDID before the display
# manager starts, so the HDMI connector already advertises modes when mutter
# enumerates it -- otherwise the output is unusable ("No modes available").
Before=display-manager.service gdm.service
After=systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/edid-fallback.sh

[Install]
WantedBy=multi-user.target
